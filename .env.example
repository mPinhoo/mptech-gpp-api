DATABASE_URL="postgresql://user:password@localhost:5432/mptech_gpp?schema=public"
# At least 32 characters: openssl rand -hex 48
JWT_SECRET=""
PORT=3001
CORS_ORIGIN="http://localhost:3000,https://mptech-gpp-prod-ui.vercel.app"
# Number of reverse proxies in front of the API (Render: 1). Empty locally.
TRUST_PROXY_HOPS=

# Chatbot de ajuda (wiki)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
WIKI_PATH=""

# --- Assinaturas (Asaas + Brevo). Secrets belong ONLY to the backend. ---
# "true" turns on paid sign-up and disables the free /auth/register.
BILLING_ENABLED=
# sandbox (default) | production
ASAAS_ENV=
# Production also requires BILLING_LIVE_APPROVED=true (human go-live switch).
BILLING_LIVE_APPROVED=
# Sandbox: $aact_hmlg_... | Production: $aact_prod_... (wrap in single quotes)
ASAAS_API_KEY=
# Same value registered in the Asaas webhook. openssl rand -hex 48
ASAAS_WEBHOOK_TOKEN=
# Signs checkout status links. openssl rand -hex 48
BILLING_STATUS_SECRET=
# Encrypts queued emails. 64 hex characters: openssl rand -hex 32
BILLING_ENCRYPTION_KEY=
# Public HTTPS URL of the frontend (Asaas rejects http/localhost callbacks).
BILLING_APP_URL=
# Days of access kept after a missed renewal (default 3).
BILLING_GRACE_DAYS=
BREVO_API_KEY=
# Must be a sender/domain verified in Brevo.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Sandbox only: the single recipient allowed to receive billing emails.
BILLING_TEST_EMAIL=
# Used by `npm run billing:webhook` to register the Asaas webhook.
ASAAS_WEBHOOK_URL=
ASAAS_WEBHOOK_EMAIL=
